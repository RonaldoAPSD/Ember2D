(
    name: "Visual Polish Demo",
    width: 100,
    height: 100,
    spawn_point: (10.0, 10.0),
    player: (
        glyph: '@',
        fg: Green,
        bg: Reset,
        solid: false,
        trigger: false,
        tag: "player",
        camera_follow: true,
        script: Some("demo/scripts/player.rhai"),
    ),
    tiles: [
        // Corner markers
        (x: 0, y: 0, glyph: '#', fg: Grey, bg: Reset, solid: true, trigger: false, tag: "wall", layer: 1),
        (x: 99, y: 0, glyph: '#', fg: Grey, bg: Reset, solid: true, trigger: false, tag: "wall", layer: 1),
        (x: 0, y: 99, glyph: '#', fg: Grey, bg: Reset, solid: true, trigger: false, tag: "wall", layer: 1),
        (x: 99, y: 99, glyph: '#', fg: Grey, bg: Reset, solid: true, trigger: false, tag: "wall", layer: 1),
        
        // Demo objects
        (x: 15, y: 10, glyph: 'F', fg: Cyan, bg: Reset, solid: false, trigger: false, tag: "fountain", layer: 1, script: Some("demo/scripts/fountain.rhai")),
        (x: 10, y: 15, glyph: 'T', fg: Yellow, bg: Reset, solid: false, trigger: false, tag: "torch", layer: 1, script: Some("demo/scripts/torch.rhai")),
        
        // A few floors to walk on
        (x: 10, y: 10, glyph: '.', fg: DarkGrey, bg: Reset, solid: false, trigger: false, tag: "floor", layer: 0),
        (x: 11, y: 10, glyph: '.', fg: DarkGrey, bg: Reset, solid: false, trigger: false, tag: "floor", layer: 0),
        (x: 12, y: 10, glyph: '.', fg: DarkGrey, bg: Reset, solid: false, trigger: false, tag: "floor", layer: 0),
        (x: 13, y: 10, glyph: '.', fg: DarkGrey, bg: Reset, solid: false, trigger: false, tag: "floor", layer: 0),
        (x: 14, y: 10, glyph: '.', fg: DarkGrey, bg: Reset, solid: false, trigger: false, tag: "floor", layer: 0),
        (x: 10, y: 11, glyph: '.', fg: DarkGrey, bg: Reset, solid: false, trigger: false, tag: "floor", layer: 0),
        (x: 10, y: 12, glyph: '.', fg: DarkGrey, bg: Reset, solid: false, trigger: false, tag: "floor", layer: 0),
        (x: 10, y: 13, glyph: '.', fg: DarkGrey, bg: Reset, solid: false, trigger: false, tag: "floor", layer: 0),
        (x: 10, y: 14, glyph: '.', fg: DarkGrey, bg: Reset, solid: false, trigger: false, tag: "floor", layer: 0),
    ]
)
